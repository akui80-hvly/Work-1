void setup() {
  size(1300, 500);
  background(0);
  drawface();
}

void drawface() {
  stroke(255, 255, 255);
  strokeWeight(3);
  line(0, 50, 1300, 50);
  for(int x = 0; x <= width; x+=50) {
    line(x, 0, x, 50);
    char number = (char)(x / 50);
    text(number, x, 10);
  }
}

