int squarex;
int squarey;
boolean play = true;
int circlex;
int circley;

void setup() {
  size(600, 400);
  background(255, 255, 255);
}

void draw() {
  drawsquare(squarex, squarey, 20);
  drawcircle(circlex, circley, 20);
}

void drawsquare(int x, int y, int size) {
  fill(0);
  rect(x, y, size, size);
}

void drawcircle (int x, int y, int d) {
  circle(x, y, d);
}

void mouseDragged() {
  line(squarex, squarey, circlex, circley);
}

void keyPressed() {
  if (key == ' ') {
    play = !play;
  }
  if (key == 'w' || keyCode == UP) {
    squarey -= 5;
  }
  if (key == 'a' || keyCode == LEFT) {
    squarex -= 5;
  }
  if (key == 's' || keyCode == DOWN) {
    squarey += 5;
  }
  if (key == 'd' || keyCode == RIGHT) {
    squarex += 5;
  }
  if (key == 'q') {
    squarex = width / 2;
    squarey = height / 2;
}
